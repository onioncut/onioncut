{
  "name": "onioncut-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @onioncut/examples run dev",
    "record": "pnpm --filter @onioncut/examples run record",
    "tsc": "pnpm -r run tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm lint && pnpm tsc && changeset publish && git push --follow-tags"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "packageManager": "pnpm@9.15.9"
}
