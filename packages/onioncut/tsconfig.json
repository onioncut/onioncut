{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "onioncut": [
        "./src/api.ts"
      ]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*",
    "bin/**/*",
    "tailwind.config.js",
    "tailwind.preset.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
